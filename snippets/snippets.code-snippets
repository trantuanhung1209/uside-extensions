    "body": [
      "import React, { useMemo, useState } from \"react\";",
      "import { View, Text, Pressable, FlatList, StyleSheet } from \"react-native\";",
      "",
      "type Product = { id: string; name: string; price: number };",
      "type CartItem = Product & { quantity: number };",
      "",
      "const PRODUCTS: Product[] = [",
      "  { id: \"1\", name: \"Áo\", price: 100000 },",
      "  { id: \"2\", name: \"Quần\", price: 200000 },",
      "];",
      "",
      "export default function App() {",
      "  const [cart, setCart] = useState<CartItem[]>([]);",
      "",
      "  const addToCart = (product: Product) => setCart(prev => {",
      "    const exists = prev.some(item => item.id === product.id);",
      "    return exists",
      "      ? prev.map(item => item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item)",
      "      : [...prev, { ...product, quantity: 1 }];",
      "  });",
      "",
      "  const increase = (id: string) => setCart(prev => prev.map(item =>",
      "    item.id === id ? { ...item, quantity: item.quantity + 1 } : item",
      "  ));",
      "  const decrease = (id: string) => setCart(prev => prev",
      "    .map(item => item.id === id ? { ...item, quantity: item.quantity - 1 } : item)",
      "    .filter(item => item.quantity > 0)",
      "  );",
      "  const remove = (id: string) => setCart(prev => prev.filter(item => item.id !== id));",
      "",
      "  const totalQuantity = useMemo(() => cart.reduce((sum, item) => sum + item.quantity, 0), [cart]);",
      "  const totalPrice = useMemo(() => cart.reduce((sum, item) => sum + item.price * item.quantity, 0), [cart]);",
      "",
      "  return (",
      "    <View style={styles.container}>",
      "      <Text style={styles.title}>Sản phẩm</Text>",
      "      {PRODUCTS.map(product => (",
      "        <View key={product.id} style={styles.row}>",
      "          <Text style={{ flex: 1 }}>{product.name} - {product.price} đ</Text>",
      "          <Pressable onPress={() => addToCart(product)}><Text>Thêm</Text></Pressable>",
      "        </View>",
      "      ))}",
      "      <Text style={styles.title}>Giỏ hàng ({totalQuantity})</Text>",
      "      <FlatList<CartItem>",
      "        data={cart}",
      "        keyExtractor={item => item.id}",
      "        ListEmptyComponent={<Text>Giỏ hàng trống</Text>}",
      "        renderItem={({ item }) => (",
      "          <View style={styles.row}>",
      "            <View style={{ flex: 1 }}>",
      "              <Text>{item.name}</Text>",
      "              <Text>{item.price} × {item.quantity} = {item.price * item.quantity} đ</Text>",
      "            </View>",
      "            <Pressable onPress={() => decrease(item.id)}><Text> − </Text></Pressable>",
      "            <Text>{item.quantity}</Text>",
      "            <Pressable onPress={() => increase(item.id)}><Text> + </Text></Pressable>",
      "            <Pressable onPress={() => remove(item.id)}><Text> Xóa </Text></Pressable>",
      "          </View>",
      "        )}",
      "      />",
      "      <Text style={styles.title}>Tổng: {totalPrice.toLocaleString(\"vi-VN\")} đ</Text>",
      "    </View>",
      "  );",
      "}",
