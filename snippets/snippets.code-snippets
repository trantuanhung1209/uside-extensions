    "Store (Recoil + RTK)": {
        "prefix": "store_atoms_rtk",
        "body": [
            "// ============================================================",
            "// RECOIL ATOMS",
            "// ============================================================",
            "import { atom } from 'recoil'",
            "",
            "export const recipesState = atom({",
            "  key: 'recipesState',",
            "  default: [],",
            "})",
            "",
            "export const userState = atom({",
            "  key: 'userState',",
            "  default: null,",
            "})",
            "",
            "// Bộ lọc theo độ khó: 'all' | 'easy' | 'medium' | 'hard'",
            "export const difficultyFilterState = atom({",
            "  key: 'difficultyFilterState',",
            "  default: 'all',",
            "})",
            "",
            "",
            "// ============================================================",
            "// RTK SLICE + ASYNC THUNKS + STORE",
            "// ============================================================",
            "import { createSlice, createAsyncThunk, configureStore } from '@reduxjs/toolkit'",
            "import {",
            "  getRecipes,",
            "  addRecipe,",
            "  deleteRecipe,",
            "  toggleFavorite,",
            "} from '../services/recipeApi'",
            "",
            "// ------------------------------------------------------------",
            "// Async Thunks — gọi API thật, sau đó reducer tự cập nhật store",
            "// ------------------------------------------------------------",
            "",
            "// Fetch toàn bộ danh sách công thức từ API",
            "export const fetchRecipesThunk = createAsyncThunk(",
            "  'recipe/fetchRecipes',",
            "  async () => {",
            "    const data = await getRecipes()",
            "    return data // fulfilled payload = mảng recipes",
            "  }",
            ")",
            "",
            "// Thêm công thức mới (POST) rồi push kết quả vào store",
            "export const addRecipeThunk = createAsyncThunk(",
            "  'recipe/addRecipe',",
            "  async (payload) => {",
            "    const created = await addRecipe(payload)",
            "    return created // fulfilled payload = recipe vừa tạo (có id từ server)",
            "  }",
            ")",
            "",
            "// Xóa công thức (DELETE) rồi lọc khỏi store",
            "export const deleteRecipeThunk = createAsyncThunk(",
            "  'recipe/deleteRecipe',",
            "  async (id) => {",
            "    await deleteRecipe(id)",
            "    return id // fulfilled payload = id đã xóa",
            "  }",
            ")",
            "",
            "// Toggle yêu thích (PUT) rồi cập nhật trường favorite trong store",
            "export const toggleFavoriteThunk = createAsyncThunk(",
            "  'recipe/toggleFavorite',",
            "  async ({ id, favorite }) => {",
            "    await toggleFavorite(id, favorite)",
            "    return { id, favorite } // fulfilled payload = { id, favorite }",
            "  }",
            ")",
            "",
            "// ------------------------------------------------------------",
            "// Slice",
            "// ------------------------------------------------------------",
            "const recipeSlice = createSlice({",
            "  name: 'recipe',",
            "  initialState: {",
            "    recipes: [],",
            "    user: null,",
            "    difficultyFilter: 'all',",
            "    loading: false,",
            "    error: null,",
            "  },",
            "  reducers: {",
            "    // Sync reducers (vẫn giữ để dùng trực tiếp nếu cần)",
            "    setRecipes(state, action) {",
            "      state.recipes = action.payload",
            "    },",
            "    addRecipeItem(state, action) {",
            "      state.recipes.push(action.payload)",
            "    },",
            "    removeRecipe(state, action) {",
            "      state.recipes = state.recipes.filter((r) => r.id !== action.payload)",
            "    },",
            "    updateRecipeFavorite(state, action) {",
            "      const { id, favorite } = action.payload",
            "      const found = state.recipes.find((r) => r.id === id)",
            "      if (found) found.favorite = favorite",
            "    },",
            "    setUser(state, action) {",
            "      state.user = action.payload",
            "    },",
            "    setDifficultyFilter(state, action) {",
            "      state.difficultyFilter = action.payload",
            "    },",
            "  },",
            "  // extraReducers xử lý kết quả từ các async thunks",
            "  extraReducers: (builder) => {",
            "    // --- fetchRecipesThunk ---",
            "    builder",
            "      .addCase(fetchRecipesThunk.pending, (state) => {",
            "        state.loading = true",
            "        state.error = null",
            "      })",
            "      .addCase(fetchRecipesThunk.fulfilled, (state, action) => {",
            "        state.loading = false",
            "        state.recipes = action.payload",
            "      })",
            "      .addCase(fetchRecipesThunk.rejected, (state, action) => {",
            "        state.loading = false",
            "        state.error = action.error.message",
            "      })",
            "",
            "    // --- addRecipeThunk ---",
            "    builder",
            "      .addCase(addRecipeThunk.fulfilled, (state, action) => {",
            "        state.recipes.push(action.payload)",
            "      })",
            "",
            "    // --- deleteRecipeThunk ---",
            "    builder",
            "      .addCase(deleteRecipeThunk.fulfilled, (state, action) => {",
            "        state.recipes = state.recipes.filter((r) => r.id !== action.payload)",
            "      })",
            "",
            "    // --- toggleFavoriteThunk ---",
            "    builder",
            "      .addCase(toggleFavoriteThunk.fulfilled, (state, action) => {",
            "        const { id, favorite } = action.payload",
            "        const found = state.recipes.find((r) => r.id === id)",
            "        if (found) found.favorite = favorite",
            "      })",
            "  },",
            "})",
            "",
            "export const {",
            "  setRecipes,",
            "  addRecipeItem,",
            "  removeRecipe,",
            "  updateRecipeFavorite,",
            "  setUser,",
            "  setDifficultyFilter,",
            "} = recipeSlice.actions",
            "",
            "export const store = configureStore({",
            "  reducer: {",
            "    recipe: recipeSlice.reducer,",
            "  },",
            "})"
        ],
        "description": "Recoil atoms + RTK slice/thunks/store"
    },
