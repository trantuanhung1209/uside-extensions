    "Exercise Theme Context API": {
        "prefix": "ex_theme",
        "body": [
            "import React, { createContext, useContext, useState } from 'react';",
            "",
            "// 1. Create context",
            "const ThemeContext = createContext();",
            "",
            "// 2. Custom hook to use theme",
            "function useTheme() {",
            "  const context = useContext(ThemeContext);",
            "  if (!context) {",
            "    throw new Error('useTheme must be used within ThemeProvider');",
            "  }",
            "  return context;",
            "}",
            "",
            "// 3. ThemeProvider",
            "function ThemeProvider({ children }) {",
            "  const [theme, setTheme] = useState('light');",
            "",
            "  const toggleTheme = () => {",
            "    setTheme(prev => (prev === 'light' ? 'dark' : 'light'));",
            "  };",
            "",
            "  return (",
            "    <ThemeContext.Provider value={{ theme, toggleTheme }}>",
            "      {children}",
            "    </ThemeContext.Provider>",
            "  );",
            "}",
            "",
            "// 4. Button Component",
            "function ThemedButton() {",
            "  const { theme, toggleTheme } = useTheme();",
            "",
            "  return (",
            "    <button",
            "      onClick={toggleTheme}",
            "      style={{",
            "        padding: '10px 20px',",
            "        backgroundColor: theme === 'light' ? '#007bff' : '#ffc107',",
            "        color: theme === 'light' ? 'white' : 'black',",
            "        border: 'none',",
            "        borderRadius: '5px',",
            "        cursor: 'pointer',",
            "        marginTop: '10px'",
            "      }}",
            "    >",
            "      Toggle to {theme === 'light' ? 'Dark' : 'Light'} Mode",
            "    </button>",
            "  );",
            "}",
            "",
            "// 5. Page Component",
            "function Page() {",
            "  const { theme } = useTheme();",
            "",
            "  return (",
            "    <div style={{",
            "      padding: '20px',",
            "      backgroundColor: theme === 'light' ? '#f8f9fa' : '#495057',",
            "      color: theme === 'light' ? '#212529' : '#f8f9fa',",
            "      borderRadius: '5px',",
            "      marginTop: '10px'",
            "    }}>",
            "      <h3>Page Component (Level 3)</h3>",
            "      <p>Current theme: <strong>{theme}</strong></p>",
            "      <ThemedButton />",
            "    </div>",
            "  );",
            "}",
            "",
            "// 6. Layout Component",
            "function Layout() {",
            "  const { theme } = useTheme();",
            "",
            "  return (",
            "    <div style={{",
            "      padding: '20px',",
            "      backgroundColor: theme === 'light' ? '#e9ecef' : '#343a40',",
            "      color: theme === 'light' ? '#212529' : '#f8f9fa',",
            "      borderRadius: '5px',",
            "      marginTop: '10px'",
            "    }}>",
            "      <h2>Layout Component (Level 2)</h2>",
            "      <Page />",
            "    </div>",
            "  );",
            "}",
            "",
            "// 7. Main component",
            "function ${1:Exercise2}() {",
            "  return (",
            "    <ThemeProvider>",
            "      <ThemeContent />",
            "    </ThemeProvider>",
            "  );",
            "}",
            "",
            "function ThemeContent() {",
            "  const { theme } = useTheme();",
            "",
            "  return (",
            "    <div style={{",
            "      minHeight: '100vh',",
            "      padding: '20px',",
            "      backgroundColor: theme === 'light' ? '#ffffff' : '#212529',",
            "      color: theme === 'light' ? '#212529' : '#ffffff'",
            "    }}>",
            "",
            "      <h1>Theme Manager with Context API</h1>",
            "      <p>Current Theme: <strong>{theme}</strong></p>",
            "",
            "      <ThemedButton />",
            "",
            "      <Layout />",
            "    </div>",
            "  );",
            "}",
            "",
            "export default ${1:Exercise2};"
        ],
        "description": "React Context API Theme Manager Example"
    },
