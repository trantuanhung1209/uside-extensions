        "prefix": "hook_useEffect_debounce",
        "body": [
            "import React, { useState, useEffect } from \"react\";",
            "",
            "export default function DebounceSearch() {",
            "  const [search, setSearch] = useState(\"\");",
            "  const [debounced, setDebounced] = useState(\"\");",
            "",
            "  useEffect(() => {",
            "    const timer = setTimeout(() => {",
            "      setDebounced(search);",
            "    }, 500);",
            "",
            "    return () => clearTimeout(timer);",
            "  }, [search]);",
            "",
            "  return (",
            "    <div>",
            "      <h2>Debounce Search</h2>",
            "",
            "      <input",
            "        placeholder=\"Search...\"",
            "        value={search}",
            "        onChange={(e) => setSearch(e.target.value)}",
            "      />",
            "",
            "      <p>Search value: {debounced}</p>",
            "    </div>",
            "  );",
            "}"
        ],
        "description": "React debounce search example using useEffect"
    },
    "React Custom Hook useCounter": {
        "prefix": "hook_useCounter",
        "body": [
            "import { useState } from \"react\";",
            "",
            "function useCounter(initial = 0) {",
            "  const [count, setCount] = useState(initial);",
            "",
            "  const inc = () => setCount(c => c + 1);",
            "  const dec = () => setCount(c => c - 1);",
            "  const reset = () => setCount(initial);",
            "",
            "  return { count, inc, dec, reset };",
            "}",
            "",
            "export default useCounter;"
        ],
        "description": "Custom hook useCounter with increment, decrement, reset"
    },
    "React Hook useFetchUsers": {
        "prefix": "hook_fetch_users",
        "body": [
            "import { useEffect, useState } from \"react\";",
            "",
            "function useFetchUsers() {",
            "  const [users, setUsers] = useState([]);",
            "  const [loading, setLoading] = useState(true);",
            "  const [error, setError] = useState({ error: false, message: \"\" });",
            "",
            "  const fetchUsers = async (userId = \"\") => {",
            "    setLoading(true);",
            "    try {",
            "      const res = await fetch(`https://jsonplaceholder.typicode.com/users/${userId}`);",
            "      if (!res.ok) throw new Error(\"Khong the tai du lieu\");",
            "",
            "      const data = await res.json();",
            "      setUsers(Array.isArray(data) ? data : [data]);",
            "      setError({ error: false, message: \"\" });",
            "    } catch (err) {",
            "      setError({ error: true, message: err.message });",
            "      setUsers([]);",
            "    } finally {",
            "      setLoading(false);",
            "    }",
            "  };",
            "",
            "  useEffect(() => {",
            "    fetchUsers();",
            "  }, []);",
            "",
            "  return { users, loading, error, fetchUsers };",
            "}",
            "",
            "export default useFetchUsers;"
        ],
        "description": "Custom hook to fetch users with loading & error"
    },
