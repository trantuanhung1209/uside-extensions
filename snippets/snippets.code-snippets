                        "    const fetchBooks = async () => {",
                        "      try {",
                        "        setLoading(true)",
                        "        const data = await getBooks()",
                        "        if (isMounted) {",
                        "          setBooks(data)",
                        "        }",
                        "      } catch (error) {",
                        "        window.alert('Không thể tải danh sách sách.')",
